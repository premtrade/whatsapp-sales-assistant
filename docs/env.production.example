# =====================================================================
# WhatsApp Sales Assistant - Production Environment Template
# =====================================================================
# IMPORTANT: Copy this file to the project root as .env and fill in
# your own values. Do NOT commit the real .env file to git.
# =====================================================================

# General
ENVIRONMENT=production
PORT=4000
FRONTEND_URL=https://waflo.com
CORS_ORIGINS=https://waflo.com,https://waflo.vercel.app
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=whatsapp_sales
DATABASE_URL=postgresql://postgres:change_me_strong_password@postgres:5432/whatsapp_sales

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_password
REDIS_URL=redis://:change_me_strong_password@redis:6379

# JWT
JWT_SECRET=change_me_to_a_random_64_char_string
JWT_EXPIRES_IN=24h

# AI / LLM
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# WhatsApp (WAHA)
WAHA_API_URL=http://waha:3000
WAHA_API_KEY=your_waha_api_key_here
WHATSAPP_SESSION=default

# n8n
N8N_URL=http://n8n:5678
N8N_API_KEY=your_n8n_api_key_here

# Encryption
ENCRYPTION_KEY=change_me_to_a_random_32_char_string

# Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
