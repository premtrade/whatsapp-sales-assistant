# =============================================================================
# WhatsApp Sales Assistant - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=whatsapp_sales
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_SCHEMA=public

# -----------------------------------------------------------------------------
# pgAdmin
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=premtrade12@yahoo.com
PGADMIN_PASSWORD=change_me_strong_password
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_password
REDIS_DB=0

# -----------------------------------------------------------------------------
# Qdrant (Vector Database)
# -----------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=whatsapp_sales
QDRANT_API_KEY=change_me_strong_password

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------
N8N_HOST=n8n
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_USER=admin
N8N_PASSWORD=change_me_to_a_strong_password
N8N_ENCRYPTION_KEY=change_me_to_a_random_32_char_string
N8N_WEBHOOK_URL=http://localhost:5678
N8N_DB=n8n

# -----------------------------------------------------------------------------
# Flowise
# -----------------------------------------------------------------------------
FLOWISE_HOST=flowise
FLOWISE_PORT=3000
# Flowise uses its own database (separate from n8n) to avoid migration conflicts
FLOWISE_DB=flowise
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=change_me_flowise_password
# JWT secret for Flowise authentication (use a random 32+ character string)
FLOWISE_JWT_SECRET=change_me_to_a_random_32_char_string
FLOWISE_APIKEY=

# -----------------------------------------------------------------------------
# WAHA (WhatsApp HTTP API)
# -----------------------------------------------------------------------------
WAHA_HOST=waha
WAHA_PORT=3000
WAHA_API_KEY=change_me_waha_api_key
# Username and password for WAHA basic authentication
WAHA_USERNAME=admin
WAHA_PASSWORD=change_me_waha_password
# Session name used by WAHA to identify the WhatsApp session
WAHA_SESSION=default
# WhatsApp events WAHA should forward into n8n (adjust to match your WAHA version
# and Workflow 1's event filter)
WAHA_WEBHOOK_EVENTS=["message.create","message.update","message.reaction"]

# -----------------------------------------------------------------------------
# Traefik (Reverse Proxy)
# -----------------------------------------------------------------------------
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_DOMAIN=whatsapp-sales.local
# Email address for Let's Encrypt certificate registration
TRAEFIK_ACME_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
BACKEND_HOST=backend
BACKEND_PORT=4000
BACKEND_JWT_SECRET=change_me_to_a_random_64_char_string
BACKEND_JWT_EXPIRES_IN=1d

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_HOST=frontend
FRONTEND_PORT=3000
# Public URL the frontend is served from
FRONTEND_PUBLIC_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# AI / LLM Provider (OpenAI-compatible)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
GROQ_API_KEY=sk-your-groq-api-key
OPENAI_MODEL=gpt-4o-mini
# Optional: override the base URL for OpenAI-compatible providers
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
