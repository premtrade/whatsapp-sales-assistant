# =============================================================================
# WhatsApp Sales Assistant - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=whatsapp_sales
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_SCHEMA=public

# -----------------------------------------------------------------------------
# pgAdmin
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=premtrade12@yahoo.com
PGADMIN_PASSWORD=change_me_strong_password
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_password
REDIS_DB=0

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------
N8N_HOST=n8n
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_USER=admin
N8N_PASSWORD=change_me_to_a_strong_password
# IMPORTANT: Set this to a stable random 32-character string before first run.
# If blank or changed after credentials are saved, all stored credentials break.
N8N_ENCRYPTION_KEY=change_me_to_a_random_32_char_string
N8N_WEBHOOK_URL=http://localhost:5678
N8N_DB=n8n

# -----------------------------------------------------------------------------
# WAHA (WhatsApp HTTP API)
# -----------------------------------------------------------------------------
WAHA_HOST=waha
WAHA_PORT=3000
WAHA_API_KEY=change_me_waha_api_key
# Username and password for WAHA dashboard authentication
WAHA_USERNAME=admin
WAHA_PASSWORD=change_me_waha_password
# Session name used by WAHA to identify the WhatsApp session
WAHA_SESSION=default
# WhatsApp events WAHA should forward into n8n (adjust to match your WAHA version
# and Workflow 1's event filter)
WAHA_WEBHOOK_EVENTS=["message.create","message.update","message.reaction"]

# -----------------------------------------------------------------------------
# AI / LLM Models
# -----------------------------------------------------------------------------
# Chat model recorded as the per-business default (settings.ai_model) and shown
# in the UI. Keep it identical to the model configured on the n8n node
# 'Workflow 2 - AI Brain' -> Groq Chat Model, otherwise the two disagree.
AI_DEFAULT_MODEL=qwen/qwen3.8-27b
# Embedding provider model used by the backend (pgvector, 768 dimensions).
EMBEDDING_MODEL=gemini-embedding-001
# Required by the backend to embed knowledge documents (see docker-compose.yml).
GEMINI_API_KEY=your-google-gemini-api-key
# Read by the n8n container (docker-compose.yml) for the Groq Chat Model node in
# 'Workflow 2 - AI Brain'. The model it points at must match AI_DEFAULT_MODEL above.
GROQ_API_KEY=sk-your-groq-api-key

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
BACKEND_HOST=backend
BACKEND_PORT=4000
# JWT secret for backend API authentication (use a random 64+ character string)
BACKEND_JWT_SECRET=change_me_to_a_random_64_char_string
BACKEND_JWT_EXPIRES_IN=1d
# Public URL the backend is reachable at (used for webhooks and CORS)
BACKEND_PUBLIC_URL=http://localhost:4000
# Comma-separated list of hosts allowed for billing return URLs (success/cancel/return)
ALLOWED_RETURN_HOSTS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_HOST=frontend
FRONTEND_PORT=3000
# Public URL the frontend is served from
FRONTEND_PUBLIC_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Legacy / optional provider keys
# -----------------------------------------------------------------------------
# The chat model runs on Groq inside n8n and embeddings run on Gemini in the
# backend. This OpenAI key is only forwarded to n8n for optional nodes; the
# backend never reads it.
OPENAI_API_KEY=sk-your-openai-api-key

# -----------------------------------------------------------------------------
# AI Embeddings (Hugging Face) - used by scripts/embed_memory.py for vector RAG
# -----------------------------------------------------------------------------
# Write-access token from hf.co/settings/tokens. Leave blank/mock to run the
# memory builder in local-mock mode (deterministic pseudo-vectors) for testing.
HUGGINGFACE_API_KEY=hf_your_write_access_token
# Must match the default in scripts/embed_knowledge_hf.py (768 dimensions)
HF_EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIMS=768

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
BACKUP_DIR=./backups
# Number of days to retain backups before pruning old ones
BACKUP_RETENTION_DAYS=7
