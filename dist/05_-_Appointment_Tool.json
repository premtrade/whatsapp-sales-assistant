    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO appointments (business_id, contact_id, conversation_id, appointment_type, title, location, starts_at, ends_at) VALUES ($1::uuid, $2::uuid, $3::uuid, $4, $5, $6, $7::timestamptz, $8::timestamptz) RETURNING id, contact_id, appointment_type, status, title, location, starts_at, ends_at, created_at;",
        "options": {
          "queryReplacement": "={{ $('When Executed by Another Workflow').first().json.business_id }}\n{{ $json.contact_id }}\n{{ $json.conversation_id }}\n{{ $json.appointment_type }}\n{{ $json.title }}\n{{ $json.location }}\n{{ $json.starts_at }}\n{{ $json.ends_at }}"
        }
      },
