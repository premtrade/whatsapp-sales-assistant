      "id": "b014074c-88ff-4453-a484-633f4faff070",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "const input = $('When Executed by Another Workflow').first()?.json || {};\nconst preferredDate = input.preferred_date;\nconst preferredTime = input.preferred_time;\nconst durationMinutes = Number(input.duration_minutes || 60);\n\nif (!preferredDate || !preferredTime) {\n  return [{\n    json: {\n      success: false,\n      appointment_ready: false,\n      error: 'Appointment requires a preferred_date and preferred_time.',\\n      contact_id: input.contact_id,\\n      conversation_id: input.conversation_id\n    }\n  }];\n}\n\nconst dateTimeString = `${preferredDate}T${preferredTime}:00`;\nconst dateTime = new Date(dateTimeString);\n\nif (isNaN(dateTime.getTime())) {\n  return [{\n    json: {\n      success: false,\n      appointment_ready: false,\n      error: 'Supplied date or time string is invalid.',\n      contact_id: input.contact_id,\n      conversation_id: input.conversation_id\n    }\n  }];\n}\n\nconst endTime = new Date(dateTime.getTime() + (durationMinutes * 60 * 1000));\n\nreturn [{\n  json: {\n    success: true,\n    appointment_ready: true,\n    contact_id: input.contact_id,\n    conversation_id: input.conversation_id,\n    appointment_type: input.appointment_type || 'site_visit',\n    title: input.title || 'Site Visit',\n    location: input.location || null,\n    starts_at: dateTime.toISOString().replace(/\\.\\d{3}Z$/, 'Z'),\n    ends_at: endTime.toISOString().replace(/\\.\\d{3}Z$/, 'Z'),\n    duration_minutes: durationMinutes\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "id": "5b4878d6-0a45-4ad0-9a35-98a6fe572ab0",
      "name": "Validate Inputs"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "appt-ready-check",
              "leftValue": "={{ $json.appointment_ready }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        368,
        0
      ],
      "id": "5792088f-ebae-4d66-80e4-36f7b8ff4965",
      "name": "Inputs Valid?"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) AS conflict_count FROM appointments a WHERE a.contact_id = $3::uuid AND a.business_id = $4::uuid AND a.status IN ('scheduled', 'confirmed') AND a.starts_at < ($1::timestamptz + ($2 || ' minutes')::interval) AND a.ends_at > $1::timestamptz;",
        "options": {
          "queryReplacement": "={{ $json.starts_at }}\n{{ $json.duration_minutes }}\n{{ $json.contact_id }}\n{{ $('When Executed by Another Workflow').first().json.business_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        480,
        64
      ],
      "id": "5766d056-7956-4f8f-a8ed-7e783bc78616",
      "name": "Check for Conflicts",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "tOjZeRRL1hW2zbUk",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $('Validate Inputs').first().json;\nconst conflict = $('Check for Conflicts').first()?.json || {};\nconst hasConflict = Number(conflict.conflict_count || 0) > 0;\n\nreturn [{\n  json: {\n    ...input,\n    has_conflict: hasConflict\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
