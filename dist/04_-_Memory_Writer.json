    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO customer_facts (contact_id, fact_key, fact_value, confidence, source)\nVALUES ($1::uuid, 'customer_name', $2, 0.99, 'ai')\nON CONFLICT (contact_id, fact_key)\nDO UPDATE SET fact_value = EXCLUDED.fact_value, confidence = EXCLUDED.confidence, source = EXCLUDED.source, updated_at = NOW()\nRETURNING id, contact_id, fact_key, fact_value, confidence, source, updated_at;",
        "options": {
          "queryReplacement": "={{ $('Extract Customer Name').item.json.contact_id }}\n{{ $('Extract Customer Name').item.json.customer_name }}"
        }
      },
