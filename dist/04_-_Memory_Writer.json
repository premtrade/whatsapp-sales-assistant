    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a customer-memory extraction system for a WhatsApp sales assistant.\n\nYour job is to identify useful, durable customer facts from the customer's latest message.\n\nONLY extract information that is explicitly stated or strongly implied by the customer's message.\n\nDo NOT invent facts.\nDo NOT extract temporary conversational statements.\nDo NOT extract the customer's name.\n\nAllowed fact types:\n- service_interest\n- property_type\n- location\n- preferred_date\n- preferred_time\n- budget\n- project_description\n- urgency\n- company\n- email\n- preferred_language\n\nALWAYS extract budget as a string preserving full currency values like 'JMD 20,000'.\n\nCustomer message:\n{{ $('When Executed by Another Workflow').item.json.message }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a precise customer-memory extraction engine. Return only the requested structured JSON output."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        896,
        0
      ],
      "id": "9af6c851-dbd2-4d69-88d5-a5479a2dcdea",
      "name": "Extract Customer Facts"
    },
