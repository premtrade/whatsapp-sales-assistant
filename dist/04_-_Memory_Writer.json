        "operation": "executeQuery",
        "query": "INSERT INTO customer_facts (contact_id, fact_key, fact_value, confidence, source)\nSELECT * FROM json_to_recordset($1::json)\n  AS x(contact_id uuid, fact_key text, fact_value text, confidence numeric, source text)\nON CONFLICT (contact_id, fact_key)\nDO UPDATE SET fact_value = EXCLUDED.fact_value, confidence = EXCLUDED.confidence, source = EXCLUDED.source, updated_at = NOW();",
