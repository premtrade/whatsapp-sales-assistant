        "model": "openai/gpt-oss-safeguard-20b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        912,
        208
      ],
      "id": "0e0b8f54-b6a9-411d-8d59-504c7cd365bd",
      "name": "Groq Chat Model",
      "credentials": {
        "groqApi": {
          "id": "wXpNdoZt6qFdQVc2",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"facts\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"fact_key\": { \"type\": \"string\" },\n          \"fact_value\": { \"type\": \"string\" },\n          \"confidence\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 1 }\n        },\n        \"required\": [\"fact_key\", \"fact_value\", \"confidence\"]\n      }\n    }\n  },\n  \"required\": [\"facts\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1056,
        272
      ],
      "id": "b5d1da28-44db-49cd-9ede-0c4e69d1ce5d",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const result = $('Extract Customer Facts').first()?.json || {};\nconst facts = result.output?.facts || result.facts || [];\nconst contactId = $('When Executed by Another Workflow').first().json.contact_id;\n\nconst normalizedFacts = (Array.isArray(facts) ? facts : [])\n  .filter(f => f && f.fact_key != null && f.fact_value != null)\n  .map(f => ({\n    contact_id: contactId,\n    fact_key: String(f.fact_key).trim(),\n    fact_value: String(f.fact_value).trim(),\n    confidence: Number(f.confidence || 0.9),\n    source: 'ai'\n  }))\n  .filter(f => f.fact_key && f.fact_value && !['null', 'undefined', ''].includes(f.fact_key.toLowerCase()));\n\nreturn [{ json: { facts: normalizedFacts, count: normalizedFacts.length } }];"
      },
