  "name": "10 - Abandoned Conversation Recovery",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "a3b51e43-38be-4adc-91fe-8d68e728b927",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id AS conversation_id, c.contact_id, c.last_message_at, c.status, ct.display_name, ct.phone, ct.email, ct.business_id, b.waha_session_name, (SELECT text_body FROM messages WHERE conversation_id = c.id ORDER BY created_at DESC LIMIT 1) AS last_message_text FROM conversations c JOIN contacts ct ON c.contact_id = ct.id JOIN businesses b ON b.id = ct.business_id WHERE c.status = 'active' AND c.last_message_at < NOW() - INTERVAL '3 days' AND c.last_message_at > NOW() - INTERVAL '4 days' AND NOT EXISTS (SELECT 1 FROM messages m WHERE m.conversation_id = c.id AND m.created_at > c.last_message_at AND m.sender_type = 'staff' AND m.metadata->>'recovery_attempt' = 'true') ORDER BY c.last_message_at ASC LIMIT 10;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        240,
        0
      ],
      "id": "21c20af3-fd30-49d6-85db-7f43e7a9af95",
      "name": "Find Abandoned Conversations",
      "credentials": {
        "postgres": {
          "id": "tOjZeRRL1hW2zbUk",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const name = item.json.display_name || 'there';\n  const message = `Hi ${name}, we noticed you haven't responded to our previous message. We're here to help with your construction project! If you have any questions or would like to continue the conversation, please let us know. We'd be happy to assist you.`;\n  return {\n    json: {\n      ...item.json,\n      message,\n      recovery_attempt: true\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "2b3cb699-2b02-4953-8937-96dacfa99101",
      "name": "Format Recovery Message"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO messages (conversation_id, direction, sender_type, message_type, text_body, metadata, created_at, updated_at) VALUES ($1::uuid, 'outgoing', 'staff', 'text', $2, $3, NOW(), NOW());",
        "options": {
          "queryReplacement": "={{ $json.conversation_id }}\n={{ $json.message }}\n={{ JSON.stringify({ recovery_attempt: true, automated: true, original_message_at: $json.last_message_at }) }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        720,
        0
      ],
      "id": "add67908-144f-4475-9032-4b16568b3a4d",
      "name": "Insert Recovery Message",
      "credentials": {
        "postgres": {
          "id": "tOjZeRRL1hW2zbUk",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://waha:3000/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "waha_2026"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"session\": \"{{ $json.waha_session_name || 'default' }}\",\n  \"chatId\": \"{{ $json.phone }}\",\n  \"text\": \"{{ $json.message }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        848,
        0
      ],
      "id": "e03c6b60-27bc-4a24-9270-576ab64af3fd",
      "name": "WAHA Send Recovery",
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit_logs (entity_type, entity_id, action, performed_by, performed_by_type, description, new_values, metadata) VALUES ('conversation', $1::uuid, 'recovery_attempt', 'system', 'automation', $2, jsonb_build_object('recovery_attempt', true), jsonb_build_object('contact_id', $3::uuid, 'timestamp', NOW())) RETURNING id;",
        "options": {
          "queryReplacement": "={{ $json.conversation_id }}\n={{ 'Recovery attempt sent for abandoned conversation' }}\n={{ $json.contact_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
