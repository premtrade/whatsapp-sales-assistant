    {
      "parameters": {
        "jsCode": "try { const ctx = $input.first()?.json || {}; const facts = Array.isArray(ctx.customer_facts) ? ctx.customer_facts.filter(f => f && f.fact_key && f.fact_value !== null && f.fact_value !== undefined && f.fact_key !== 'null') : []; const factName = facts.find(f => f.fact_key === 'customer_name')?.fact_value || ''; const businessName = ctx.business_name || 'our company'; const customerName = (ctx.customer?.name && ctx.customer.name !== 'Unknown' ? ctx.customer.name : factName) || 'Unknown'; let prompt = `AUTHORITATIVE BUSINESS IDENTITY: ${businessName}\\nNever output unresolved template expressions such as {{ $json.business_name }}. If asked about the business, answer using the business identity above.\\n`; if (customerName !== 'Unknown') prompt += `AUTHORITATIVE CUSTOMER NAME: ${customerName}\\nIf asked the customer name, answer it directly.\\n`; if (ctx.customer?.phone) prompt += `CUSTOMER PHONE: ${ctx.customer.phone}\\n`; if (facts.length) { prompt += '\\nCUSTOMER FACTS:\\n'; for (const f of facts) prompt += `- ${f.fact_key}: ${f.fact_value}\\n`; } if (Array.isArray(ctx.knowledge) && ctx.knowledge.length) { prompt += '\\nAUTHORITATIVE KNOWLEDGE:\\n'; for (const kb of ctx.knowledge.slice(0, 8)) prompt += `- ${kb.chunk_text}\\n`; } if (Array.isArray(ctx.products) && ctx.products.length) { prompt += '\\nPRODUCTS:\\n'; for (const p of ctx.products.slice(0, 20)) prompt += `- ${p.name}: ${p.price} ${p.currency}\\n`; } const recent = Array.isArray(ctx.recent_messages) ? ctx.recent_messages.slice(-6) : []; const history = recent.map(m => `${m.direction === 'in' || m.direction === 'incoming' ? 'Customer' : 'Assistant'}: ${m.text_body}`).join('\\n') || 'No previous messages.'; return [{ json: { formattedPrompt: prompt, business_name: businessName, business_timezone: ctx.business_timezone || 'America/Jamaica', conversationHistory: history, customerFacts: facts, customerName, currentMessage: ctx.current_message?.text || '' } }]; } catch(e) { return [{ json: { formattedPrompt: 'AUTHORITATIVE BUSINESS IDENTITY: our company\\nNo context available.', business_name: 'our company', conversationHistory: 'No previous messages.', customerFacts: [], customerName: 'Unknown' } }]; }"
      },
