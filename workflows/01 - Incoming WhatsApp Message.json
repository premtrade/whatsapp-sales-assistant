        "query": "INSERT INTO conversations (business_id, contact_id, channel, status, last_message_at)\nSELECT business_id, id, 'whatsapp', 'active', NOW()\nFROM contacts\nWHERE id = $1::uuid\nON CONFLICT (contact_id, channel)\nDO UPDATE SET last_message_at = NOW()\nRETURNING id, business_id;",
