                  {
                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "SELECT q.id, q.quote_number, q.contact_id, q.conversation_id, q.created_at, q.status, q.sent_at, c.display_name, c.phone, c.email, c.business_id, b.waha_session_name\nFROM quotes q\nJOIN contacts c ON q.contact_id = c.id AND c.business_id = q.business_id\nJOIN businesses b ON b.id = q.business_id\nWHERE q.status = \u0027sent\u0027 AND q.sent_at IS NOT NULL\n  AND q.sent_at \u003c NOW() - INTERVAL \u002724 hours\u0027 AND q.sent_at \u003e NOW() - INTERVAL \u002725 hours\u0027\n  AND NOT EXISTS (SELECT 1 FROM messages m WHERE m.conversation_id = q.conversation_id AND m.business_id = q.business_id\n    AND m.created_at \u003e q.sent_at AND (m.direction = \u0027in\u0027 OR (m.sender_type = \u0027staff\u0027 AND (m.metadata-\u003e\u003e\u0027automated\u0027 IS DISTINCT FROM \u0027true\u0027 OR COALESCE(m.metadata-\u003e\u003e\u0027delivery_status\u0027, \u0027sent\u0027) = \u0027sent\u0027))))\nLIMIT 10;",
                                         "options":  {

                                                     }
                                     },
