                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\nreturn items.map(item =\u003e {\n  const name = item.json.display_name || \u0027there\u0027;\n  const subject = item.json.quote_subject || \u0027your recent enquiry\u0027;\n  const message = Hello ${name}, I wanted to follow up on the quote we sent regarding ${subject}. Do you have any questions or would you like to discuss any details? We are here to help!;\n  return { json: { ...item.json, message, follow_up_type: \u002724h\u0027, template_used: \u0027quote_follow_up_24h\u0027 } };\n});"
                                     },
                      "type":  "n8n-nodes-base.code",
