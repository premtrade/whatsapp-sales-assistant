                      "position":  [
                                       -560,
                                       200
                                   ],
                      "id":  "format-3day-message",
                      "name":  "Format 3-Day Message"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\nreturn items.map(item =\u003e {\n  const name = item.json.display_name || \u0027there\u0027;\n  const subject = item.json.quote_subject || \u0027your recent enquiry\u0027;\n  const message = Dear ${name}, as a valued contact, I wanted to let you know we currently have availability to assist you. If you would like to move forward regarding ${subject}, we would be pleased to offer you priority service. Please let us know if you are interested!;\n  return { json: { ...item.json, message, follow_up_type: \u00277day\u0027, template_used: \u0027quote_follow_up_7day\u0027 } };\n});"
                                     },
                      "type":  "n8n-nodes-base.code",
