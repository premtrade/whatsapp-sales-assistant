                                       400
                                   ],
                      "id":  "format-48h-message",
                      "name":  "Format 48h Message"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\nreturn items.map(item =\u003e {\n  const name = item.json.display_name || \u0027there\u0027;\n  const subject = item.json.quote_subject || \u0027your recent enquiry\u0027;\n  const message = Hi ${name}, I hope you had a chance to review the quote for ${subject}. If you would like to proceed or have any questions, please let us know. We would be happy to assist.;\n  return { json: { ...item.json, message, follow_up_type: \u00273day\u0027, template_used: \u0027quote_follow_up_3day\u0027 } };\n});"
                                     },
                      "type":  "n8n-nodes-base.code",
