                      "position":  [
                                       -560,
                                       0
                                   ],
                      "id":  "format-24h-message",
                      "name":  "Format 24h Message"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\nreturn items.map(item =\u003e {\n  const name = item.json.display_name || \u0027there\u0027;\n  const subject = item.json.quote_subject || \u0027your recent enquiry\u0027;\n  const message = Hi ${name}, just checking in on the quote we sent regarding ${subject}. We understand timing matters - would you like to proceed, have any questions, or need us to revise anything? We\u0027re happy to assist further.;\n  return { json: { ...item.json, message, follow_up_type: \u002748h\u0027, template_used: \u0027quote_follow_up_48h\u0027 } };\n});"
                                     },
                      "type":  "n8n-nodes-base.code",
