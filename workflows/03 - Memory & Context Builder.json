          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    COALESCE(summary, '') AS summary,\n    'none' AS summary_type,\n    updated_at\nFROM conversation_summaries\nWHERE conversation_id = $1\n\nUNION ALL\n\nSELECT\n    '' AS summary,\n    'none' AS summary_type,\n    NULL AS updated_at\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM conversation_summaries\n    WHERE conversation_id = $1\n)\n\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ $('When Executed by Another Workflow').item.json.conversation_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        800,
