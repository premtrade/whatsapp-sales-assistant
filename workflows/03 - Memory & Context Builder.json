                  {
                      "parameters":  {
                                         "jsCode":  "const trigger = $(\u0027When Executed by Another Workflow\u0027).first()?.json || {};\nconst contact = $(\u0027Get Contact\u0027).first()?.json || {};\nconst conversation = $(\u0027Get Conversation\u0027).first()?.json || {};\nconst messages = $(\u0027Get Recent Messages\u0027).first()?.json?.messages || [];\nconst facts = $(\u0027Retrieve Customer Facts\u0027).first()?.json?.facts || [];\nconst summary = $(\u0027Get Conversation Summary\u0027).first()?.json || { summary: \u0027\u0027, message_count: 0, created_by: \u0027none\u0027 };\nconst knowledge = $(\u0027Get Knowledge Chunks\u0027).first()?.json?.knowledge || [];\nconst products = $(\u0027Get Products\u0027).first()?.json?.products || [];\nconst quotes = $(\u0027Get Quotes\u0027).first()?.json?.quotes || [];\nconst appointments = $(\u0027Get Appointments\u0027).first()?.json?.appointments || [];\nconst handoffs = $(\u0027Get Handoff\u0027).first()?.json?.handoffs || [];\n\nreturn [{\n  json: {\n    conversation_id: trigger.conversation_id,\n    contact_id: trigger.contact_id,\n    customer: {\n      id: contact.id || trigger.contact_id,\n      phone: contact.phone || trigger.phone,\n      name: contact.display_name || trigger.customer_name\n    },\n    conversation,\n    recent_messages: messages,\n    customer_facts: facts,\n    conversation_summary: summary,\n    knowledge,\n    products,\n    quotes,\n    appointments,\n    handoff: handoffs.length \u003e 0 ? handoffs[0] : {},\n    business_name: business?.name || settings?.setting_value || \u0027our company\u0027,\\n    business_id: business?.id || null,\n    conversationHistory: messages?.map(m =\u003e `${m.direction === \u0027in\u0027 ? \u0027Customer\u0027 : \u0027Assistant\u0027}: ${m.text_body}`).join(\u0027\n\u0027) || \u0027No previous messages.\u0027\n    current_message: {\n      message_id: trigger.message_id,\n      text: trigger.message,\n      hasMedia: trigger.hasMedia,\n      timestamp: trigger.timestamp\n    }\n  }\n}];"
