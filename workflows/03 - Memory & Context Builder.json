    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM (\n    SELECT direction, sender_type, text_body, created_at\n    FROM messages\n    WHERE conversation_id = $1\n    ORDER BY created_at DESC\n    LIMIT 10\n) recent\nORDER BY created_at ASC;",
