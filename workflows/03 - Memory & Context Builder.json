    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(\n  json_agg(\n    json_build_object(\n      'fact_key', fact_key,\n      'fact_value', fact_value,\n      'confidence', confidence\n    )\n    ORDER BY confidence DESC, updated_at DESC\n  ),\n  '[]'::json\n) AS facts\nFROM customer_facts\nWHERE contact_id = $1;",
        "options": {
          "queryReplacement": "={{ $('When Executed by Another Workflow').item.json.contact_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
