      ],
      "id": "4876feac-dda7-4084-b6d8-53dfd85c347c",
      "name": "Get Conversation Summary",
      "credentials": {
        "postgres": {
          "id": "tOjZeRRL1hW2zbUk",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(\n  json_agg(\n    json_build_object(\n      'chunk_text', chunk_text,\n      'metadata', metadata\n    )\n  ),\n  '[]'::json\n) AS knowledge\nFROM (\n  SELECT\n    chunk_text,\n    metadata\n  FROM knowledge_chunks\n  ORDER BY created_at DESC\n  LIMIT 20\n) AS chunks;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        960,
        0
      ],
      "id": "96655c46-29d7-4ee9-81b4-e61f9c10df30",
      "name": "Get Knowledge Chunks",
      "credentials": {
        "postgres": {
          "id": "tOjZeRRL1hW2zbUk",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('When Executed by Another Workflow').first().json;\n\nconst contact = $('Get Contact').first().json;\nconst conversation = $('Get Conversation').first().json;\n\nconst messages = $('Get Recent Messages')\n  .all()\n  .map(item => item.json);\n\nconst facts = $('Get Customer Facts')\n  .all()\n  .flatMap(item => item.json.facts || []);\n\nconst summary = $('Get Conversation Summary').first().json;\n\nconst knowledge = $('Get Knowledge Chunks')\n  .first()\n  .json\n  .knowledge || [];\n\nreturn [\n  {\n    json: {\n      contact,\n      conversation,\n      messages,\n      facts,\n      summary,\n      knowledge,\n\n      message: trigger.message,\n      customer_name: trigger.customer_name,\n      phone: trigger.phone,\n      conversation_id: trigger.conversation_id,\n      contact_id: trigger.contact_id\n    }\n  }\n];"
      },
